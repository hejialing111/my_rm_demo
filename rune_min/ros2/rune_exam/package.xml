<?xml version="1.0"?>
<package format="3">
  <name>rune_exam</name>
  <version>0.1.0</version>
  <description>能量机关考核：亮靶识别 + 关键点解算 + 云台击打（复用 rune_core）。</description>

  <maintainer email="you@example.com">you</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <!-- rune_source_node 的 raw 分支用 cv_bridge；视频回放走 jpeg 不需要它 -->
  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <!-- 系统依赖：核心用 OpenCV，云台节点用 Eigen；写在这里 rosdep install 才会装 -->
  <depend>libopencv-dev</depend>
  <depend>eigen</depend>

  <!-- 可选：仿真器的自定义消息（只有 rune_gimbal_node 用）。
       CMake 里用 find_package(... QUIET)，找不到就跳过云台节点。
       不能写成 <depend>，否则没 source 仿真工作区时 colcon 会因为解析不到而报错。 -->

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
